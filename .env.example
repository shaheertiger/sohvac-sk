# Copy this file to .env.local for local development, and add the same
# keys under Vercel → Project → Settings → Environment Variables for
# production. Never commit the real .env.local — it's already gitignored.

# --- Contact form (required for the "Book a Free Second Opinion" form) ---
# 1. Create a free account at https://resend.com
# 2. Create an API key: Resend dashboard → API Keys → Create
# 3. (Recommended) Verify your sending domain in Resend so emails don't
#    land in spam. Until then, CONTACT_FROM_EMAIL can stay as the Resend
#    sandbox address below.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Uplift AI Blog (required for /blog and /blog/[slug] to show posts) ---
# Server-side only — never prefix this with NEXT_PUBLIC_, and it's never
# read outside src/lib/uplift/client.ts (which imports "server-only" so a
# build fails if any client component ever tries to import it). Without
# this set, /blog just renders its empty state — the site still builds
# and runs fine either way.
# Get this token from your Uplift AI account/workspace settings.
UPLIFT_API_TOKEN=

# --- Analytics (optional) ---
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
# Create at https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Future content-publishing API (not active yet — see
# docs/content-api-architecture.md) ---
# Comma-separated "name:key" pairs, one per integration, e.g.:
#   CONTENT_API_KEYS="uplift-ai:<random-64-char-secret>"
# Generate each secret with: openssl rand -hex 32
# Leave blank until that API is actually built out.
CONTENT_API_KEYS=
