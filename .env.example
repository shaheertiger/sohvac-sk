# Copy this file to .env.local for local development, and add the same
# keys under Vercel → Project → Settings → Environment Variables for
# production. Never commit the real .env.local — it's already gitignored.

# --- Contact form (required for the "Book a Free Second Opinion" form) ---
# 1. Create a free account at https://resend.com
# 2. Create an API key: Resend dashboard → API Keys → Create
# 3. (Recommended) Verify your sending domain in Resend so emails don't
#    land in spam. Until then, CONTACT_FROM_EMAIL can stay as the Resend
#    sandbox address below.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Analytics (optional) ---
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
# Create at https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
